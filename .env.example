# Flask & Dashboard Security
PORT=5006
SECRET_KEY=change_this_to_a_random_64_char_hex_string
ADMIN_PASSWORD=change_this_admin_password

# Telegram MTProto Listener (@qeleran - from https://my.telegram.org)
TG_API_ID=12345678
TG_API_HASH=your_telegram_api_hash_here
TG_SESSION_NAME=venator_listener

# Telegram Bot API Notifier (from @BotFather -> sends alerts to @LekimZlavdinov)
TG_BOT_TOKEN=1234567890:AAH_your_botfather_token_here
TG_TARGET_CHAT_ID=123456789

# Default AI Provider Configuration (can be changed live in the Web Dashboard)
LLM_PROVIDER=groq
LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
LLM_API_KEY=gsk_your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-120b